# Database (PostgreSQL for production, SQLite for local dev)
# Local: sqlite+aiosqlite:///./data/jobhunt.db
# Production: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./data/jobhunt.db

# Checkpointer DSN (reserved for Milestone 2+)
CHECKPOINT_DSN=

# LLM provider
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=3
# Mock responses for local testing (no API key needed)
MODEL_MOCK=true

# Application
APP_NAME=JobHunt AI
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Job sources
JOB_SOURCES=fixture
FIXTURE_JOBS_PATH=data/fixtures/jobs.json

# Matching weights (FR-04)
WEIGHT_SKILLS=0.35
WEIGHT_ROLE=0.25
WEIGHT_SENIORITY=0.15
WEIGHT_LOCATION=0.10
WEIGHT_COMPENSATION=0.10
WEIGHT_INDUSTRY=0.05
JOB_MATCH_THRESHOLD=60.0

# Agent harness
MAX_AGENT_RETRIES=2
AGENT_TIMEOUT_SECONDS=60
MAX_REVISIONS=2

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage

# Dev auth (simple bearer token)
DEV_AUTH_TOKEN=dev-token